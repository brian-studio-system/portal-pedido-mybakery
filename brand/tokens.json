{
  "$schema": "https://design-tokens.org/schema.json",
  "$description": "My Bakery — design tokens (DTCG). Source of truth for Stitch and for the frontend theme.",

  "color": {
    "$type": "color",
    "ink": {
      "$value": "#14110F",
      "$description": "Warm near-black. Text, logo, primary fill."
    },
    "paper": {
      "$value": "#F7F1E6",
      "$description": "Cream page background."
    },
    "surface": {
      "$value": "#FFFCF6",
      "$description": "Cards, inputs, elevated panels."
    },
    "crust": {
      "$value": "#7A4A22",
      "$description": "Baked brown. Primary action and links. 6.6:1 on paper."
    },
    "wheat": {
      "$value": "#C9932F",
      "$description": "Toasted wheat. Fills, icons, decoration only. 2.4:1 on paper."
    },
    "wheatDeep": {
      "$value": "#8A6220",
      "$description": "Accessible accent text on paper. 4.9:1."
    },
    "terracotta": {
      "$value": "#9C4A32",
      "$description": "Error, sold out, low stock. 5.4:1 on paper."
    },
    "olive": {
      "$value": "#5F6B4A",
      "$description": "Success, available, vegetarian. 5.1:1 on paper."
    },
    "muted": {
      "$value": "#6B6259",
      "$description": "Secondary text and captions. 5.3:1 on paper."
    },
    "border": {
      "$value": "#14110F24",
      "$description": "1px structural border, ink at 14%."
    },
    "wheatSoft": {
      "$value": "#C9932F29",
      "$description": "Wheat at 16% for badge backgrounds."
    },
    "oliveSoft": {
      "$value": "#5F6B4A29",
      "$description": "Olive at 16% for badge backgrounds."
    },
    "terracottaSoft": {
      "$value": "#9C4A3229",
      "$description": "Terracotta at 16% for badge backgrounds."
    },

    "semantic": {
      "bg": { "$value": "{color.paper}" },
      "surface": { "$value": "{color.surface}" },
      "text": { "$value": "{color.ink}" },
      "textMuted": { "$value": "{color.muted}" },
      "primary": { "$value": "{color.crust}" },
      "primaryContrast": { "$value": "{color.paper}" },
      "accent": { "$value": "{color.wheat}" },
      "accentText": { "$value": "{color.wheatDeep}" },
      "danger": { "$value": "{color.terracotta}" },
      "success": { "$value": "{color.olive}" },
      "focusRing": { "$value": "{color.crust}" },
      "border": { "$value": "{color.border}" }
    }
  },

  "font": {
    "$type": "fontFamily",
    "display": {
      "$value": ["Playfair Display", "Georgia", "serif"],
      "$description": "Hero, section titles, product names, prices."
    },
    "body": {
      "$value": ["Manrope", "system-ui", "sans-serif"],
      "$description": "Interface, paragraphs, buttons, labels."
    }
  },

  "fontWeight": {
    "$type": "fontWeight",
    "regular": { "$value": 400 },
    "medium": { "$value": 500 },
    "semibold": { "$value": 600 },
    "bold": { "$value": 700 }
  },

  "fontSize": {
    "$type": "dimension",
    "displayXl": { "$value": "64px" },
    "displayL": { "$value": "48px" },
    "displayM": { "$value": "36px" },
    "heading": { "$value": "24px" },
    "bodyL": { "$value": "18px" },
    "body": { "$value": "16px" },
    "small": { "$value": "14px" },
    "label": { "$value": "12px" }
  },

  "lineHeight": {
    "$type": "number",
    "displayXl": { "$value": 1.05 },
    "displayL": { "$value": 1.1 },
    "displayM": { "$value": 1.15 },
    "heading": { "$value": 1.3 },
    "body": { "$value": 1.6 },
    "small": { "$value": 1.5 },
    "label": { "$value": 1.4 }
  },

  "letterSpacing": {
    "$type": "dimension",
    "display": { "$value": "-0.02em" },
    "normal": { "$value": "0em" },
    "label": { "$value": "0.08em" }
  },

  "space": {
    "$type": "dimension",
    "1": { "$value": "4px" },
    "2": { "$value": "8px" },
    "3": { "$value": "12px" },
    "4": { "$value": "16px" },
    "6": { "$value": "24px" },
    "8": { "$value": "32px" },
    "12": { "$value": "48px" },
    "16": { "$value": "64px" },
    "24": { "$value": "96px" }
  },

  "radius": {
    "$type": "dimension",
    "sm": { "$value": "4px", "$description": "Small inputs and tags." },
    "md": { "$value": "12px", "$description": "Cards and panels." },
    "pill": { "$value": "999px", "$description": "Buttons, badges, steppers." }
  },

  "borderWidth": {
    "$type": "dimension",
    "default": { "$value": "1px" },
    "focus": { "$value": "2px" }
  },

  "shadow": {
    "$type": "shadow",
    "soft": {
      "$value": {
        "color": "#14110F14",
        "offsetX": "0px",
        "offsetY": "8px",
        "blur": "24px",
        "spread": "0px"
      },
      "$description": "Hover and floating cart only."
    }
  },

  "size": {
    "$type": "dimension",
    "container": { "$value": "1200px" },
    "touchTarget": { "$value": "44px" },
    "controlHeight": { "$value": "48px" },
    "logoMinWidth": { "$value": "96px" }
  },

  "motion": {
    "duration": {
      "$type": "duration",
      "fast": { "$value": "180ms" },
      "base": { "$value": "220ms" },
      "max": { "$value": "300ms" }
    },
    "easing": {
      "$type": "cubicBezier",
      "out": { "$value": [0.22, 1, 0.36, 1] }
    }
  },

  "$extensions": {
    "stitch": {
      "seedColor": "#C9932F",
      "colorMode": "LIGHT",
      "colorVariant": "TONAL_SPOT",
      "headlineFont": "PLAYFAIR_DISPLAY",
      "bodyFont": "MANROPE",
      "labelFont": "MANROPE",
      "roundness": "ROUND_EIGHT",
      "deviceType": "MOBILE"
    }
  }
}
