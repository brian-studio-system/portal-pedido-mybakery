#!/bin/sh
# Bloquea pushes directos a main y develop.
# Excepción: ALLOW_PROTECTED_PUSH=1 (solo setup inicial o release final).
if [ "${ALLOW_PROTECTED_PUSH:-0}" = "1" ]; then
  exit 0
fi

while read -r local_ref local_sha remote_ref remote_sha; do
  case "$remote_ref" in
    refs/heads/main|refs/heads/develop)
      echo "❌ Push directo a '${remote_ref#refs/heads/}' bloqueado."
      echo "   Empuja tu rama y abre una PR hacia develop."
      echo "   Release final: ALLOW_PROTECTED_PUSH=1 git push origin main"
      exit 1
      ;;
  esac
done

exit 0
