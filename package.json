{
  "name": "portal-pedido-mybakery",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "openspec:validate": "openspec validate --all",
    "design:lint": "design.md lint brand/DESIGN.md",
    "design:tailwind": "design.md export --format tailwind brand/DESIGN.md",
    "design:dtcg": "design.md export --format dtcg brand/DESIGN.md",
    "stitch:serve": "stitch serve --port 3001",
    "stitch:open": "stitch open project",
    "stitch:url": "stitch url project",
    "ui:add": "shadcn add",
    "ui:info": "shadcn info",
    "ui:docs": "shadcn docs",
    "ui:search": "shadcn search @shadcn",
    "setup:hooks": "git config core.hooksPath .githooks"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "lucide-react": "^1.72.0",
    "next": "16.4.6",
    "radix-ui": "^1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@google/design.md": "0.4.0",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^24",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "^4.3.5",
    "typescript": "5.9.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.0",
    "shadcn": "^4.23.0"
  }
}
